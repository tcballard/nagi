[Desktop Entry]
Version=1.0
Type=Application
Name=Nagi
GenericName=Web Browser
Comment=A quiet native browser for Omarchy
Exec=nagi %U
Icon=nagi
Terminal=false
Categories=Network;WebBrowser;
MimeType=text/html;x-scheme-handler/http;x-scheme-handler/https;
StartupNotify=true
StartupWMClass=io.github.tcballard.Nagi
Actions=Private;

[Desktop Action Private]
Name=New Private Tab
Exec=nagi --private
